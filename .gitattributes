* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.c text eol=lf
*.h text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.tcl text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Freeze deployed Flash snapshot bytes for SHA256 reproducibility.
/flash/v11/** -text
/flash/v11/program_files/*.fs -diff

# Preserve exact bytes of the deployed SRAM snapshot and its checksums.
/sram/end23-maze/** -text
/sram/end23-maze/program_files/*.fs -diff

# Preserve the exact deployed Gowin3 V4 snapshot bytes.
/sram/gowin3-v4/** -text
/sram/gowin3-v4/program_files/*.fs -diff
