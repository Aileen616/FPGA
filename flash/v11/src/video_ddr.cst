// 双OV5640，小梅哥U4接BX72 GPIO0；2026-09-22。
// 重要：按供电相容关系采用U4奇偶脚与主板相邻脚互换，不是U4同号直连。
// 这是文档推导的配置；实物逐脚导通及模块I/O电平尚未验证。
// Bank 3 VCCIO=3.3V由用户确认；LVCMOS33沿用厂家GPIO0约束。
// 本文件未接入旧单目/IMU构建；不是可直接下载的双目工程。
// PCLK为普通I/O，尚未证明时钟路由或采样时序。
// NC和空脚不创建FPGA端口，SCCB仅允许RTL拉低/释放，不主动驱动高。
// 不启用内部上拉；模块RESET/PWDN驱动电平需按实际模块复核。
// C0_PWDN：U4-2 -> GPIO0连接器-1 -> GPIO0-0；output，Bank 3。
IO_LOC "c0_pwdn" G17;
IO_PORT "c0_pwdn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C0_D7：U4-3 -> GPIO0连接器-4 -> GPIO0-3；input，Bank 3。
IO_LOC "c0_data[7]" H18;
IO_PORT "c0_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_PCLK：U4-4 -> GPIO0连接器-3 -> GPIO0-2；input，Bank 3。
IO_LOC "c0_pclk" H17;
IO_PORT "c0_pclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_D5：U4-5 -> GPIO0连接器-6 -> GPIO0-5；input，Bank 3。
IO_LOC "c0_data[5]" M22;
IO_PORT "c0_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_D6：U4-6 -> GPIO0连接器-5 -> GPIO0-4；input，Bank 3。
IO_LOC "c0_data[6]" N22;
IO_PORT "c0_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_D3：U4-7 -> GPIO0连接器-8 -> GPIO0-7；input，Bank 3。
IO_LOC "c0_data[3]" J17;
IO_PORT "c0_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_D4：U4-8 -> GPIO0连接器-7 -> GPIO0-6；input，Bank 3。
IO_LOC "c0_data[4]" K17;
IO_PORT "c0_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_D1：U4-9 -> GPIO0连接器-10 -> GPIO0-9；input，Bank 3。
IO_LOC "c0_data[1]" K19;
IO_PORT "c0_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_D2：U4-10 -> GPIO0连接器-9 -> GPIO0-8；input，Bank 3。
IO_LOC "c0_data[2]" K18;
IO_PORT "c0_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_RST：U4-13 -> GPIO0连接器-14 -> GPIO0-11；output，Bank 3。
IO_LOC "c0_reset_n" L20;
IO_PORT "c0_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C0_D0：U4-14 -> GPIO0连接器-13 -> GPIO0-10；input，Bank 3。
IO_LOC "c0_data[0]" L19;
IO_PORT "c0_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_HR：U4-15 -> GPIO0连接器-16 -> GPIO0-13；input，Bank 3。
IO_LOC "c0_href" M20;
IO_PORT "c0_href" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_SDA：U4-16 -> GPIO0连接器-15 -> GPIO0-12；inout_open_drain，Bank 3。
IO_LOC "c0_sda" N20;
IO_PORT "c0_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C0_VS：U4-17 -> GPIO0连接器-18 -> GPIO0-15；input，Bank 3。
IO_LOC "c0_vsync" N19;
IO_PORT "c0_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C0_SCL：U4-18 -> GPIO0连接器-17 -> GPIO0-14；inout_open_drain，Bank 3。
IO_LOC "c0_scl" N18;
IO_PORT "c0_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C1_PWDN：U4-20 -> GPIO0连接器-19 -> GPIO0-16；output，Bank 3。
IO_LOC "c1_pwdn" M18;
IO_PORT "c1_pwdn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C1_D7：U4-21 -> GPIO0连接器-22 -> GPIO0-19；input，Bank 3。
IO_LOC "c1_data[7]" K16;
IO_PORT "c1_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_PCLK：U4-22 -> GPIO0连接器-21 -> GPIO0-18；input，Bank 3。
IO_LOC "c1_pclk" L16;
IO_PORT "c1_pclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_D5：U4-23 -> GPIO0连接器-24 -> GPIO0-21；input，Bank 3。
IO_LOC "c1_data[5]" M16;
IO_PORT "c1_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_D6：U4-24 -> GPIO0连接器-23 -> GPIO0-20；input，Bank 3。
IO_LOC "c1_data[6]" M15;
IO_PORT "c1_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_D3：U4-25 -> GPIO0连接器-26 -> GPIO0-23；input，Bank 3。
IO_LOC "c1_data[3]" L15;
IO_PORT "c1_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_D4：U4-26 -> GPIO0连接器-25 -> GPIO0-22；input，Bank 3。
IO_LOC "c1_data[4]" L14;
IO_PORT "c1_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_D1：U4-27 -> GPIO0连接器-28 -> GPIO0-25；input，Bank 3。
IO_LOC "c1_data[1]" L13;
IO_PORT "c1_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_D2：U4-28 -> GPIO0连接器-27 -> GPIO0-24；input，Bank 3。
IO_LOC "c1_data[2]" M13;
IO_PORT "c1_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_RST：U4-31 -> GPIO0连接器-32 -> GPIO0-27；output，Bank 3。
IO_LOC "c1_reset_n" K14;
IO_PORT "c1_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C1_D0：U4-32 -> GPIO0连接器-31 -> GPIO0-26；input，Bank 3。
IO_LOC "c1_data[0]" K13;
IO_PORT "c1_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_HR：U4-33 -> GPIO0连接器-34 -> GPIO0-29；input，Bank 3。
IO_LOC "c1_href" H15;
IO_PORT "c1_href" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_SDA：U4-34 -> GPIO0连接器-33 -> GPIO0-28；inout_open_drain，Bank 3。
IO_LOC "c1_sda" J15;
IO_PORT "c1_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// C1_VS：U4-35 -> GPIO0连接器-36 -> GPIO0-31；input，Bank 3。
IO_LOC "c1_vsync" G16;
IO_PORT "c1_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// C1_SCL：U4-36 -> GPIO0连接器-35 -> GPIO0-30；inout_open_drain，Bank 3。
IO_LOC "c1_scl" G15;
IO_PORT "c1_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC "Led[0]" Y19;
IO_PORT "Led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "Led[1]" AA18;
IO_PORT "Led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
