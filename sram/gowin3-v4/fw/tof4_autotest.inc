        "#AUTO END",
    };
    /* 启动留5秒给有线采集器打开串口；每500ms至多一条命令。 */
    if(now<5000000U||(uint32_t)(now-stamp)<500000U||index>=sizeof(script)/sizeof(script[0]))return;
    stamp=now;
    const char *s=script[index++];
    if(*s=='#'){send_line(s+1);send_line("\r\n");}
    else if(*s)command(s);
}
